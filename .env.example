MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=instascope

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

SCRAPE_DELAY_SECONDS=2
SCRAPE_HEADLESS=true
# 0 = fetch ALL posts on the profile (hard safety cap 50000)
SCRAPE_MAX_POSTS=0
SCRAPE_POSTS_PAGE_SIZE=50
SCRAPE_PAGE_DELAY_SECONDS=0.6
# 0 = enrich every post missing likes/comments/views (set a number to cap)
SCRAPE_ENRICH_MAX=0
SCRAPE_ENRICH_DELAY_SECONDS=0.9
# SCRAPE_PROXY_URL=http://user:pass@proxy:8080

FOLLOWER_GROWTH_NOTIFY_PCT=5
ENGAGEMENT_SPIKE_NOTIFY_PCT=50
