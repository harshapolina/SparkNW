MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=instascope

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
# Production: set both so the API allows the web UI origin
# CORS_ORIGINS=http://62.238.57.52:3000
# WEB_ORIGIN=http://62.238.57.52:3000
# NEXT_PUBLIC_API_URL=http://62.238.57.52:8000/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

SCRAPE_DELAY_SECONDS=2
# Seconds between bulk queue jobs (profile 2, 3, …). Higher = fewer IG rate-limits.
SCRAPE_BULK_DELAY_SECONDS=20
# Max concurrent single Add/Refresh scrapes (shared semaphore).
SCRAPE_SINGLE_CONCURRENCY=3
# Optional first-pass cap for bulk imports (default 48). Set 0 for full timeline on bulk.
# Large accounts (1k–3k+ posts) will otherwise time out mid-pagination.
SCRAPE_BULK_MAX_POSTS=48
# After each capped bulk sample, auto-queue a full (uncapped) scrape for that account.
# Sample jobs always finish first so the roster fills quickly. Set 0 to disable.
SCRAPE_BULK_DEEP_FOLLOWUP=1
# On API startup, re-queue interrupted/failed zero-data bulk profiles (default on).
# SCRAPE_REQUEUE_UNFINISHED=1
# Wall-clock limit per scrape job. Leave unset for auto (capped≈10m, full≈45m).
# SCRAPE_JOB_TIMEOUT_SECONDS=2700
SCRAPE_HEADLESS=true
# 0 = fetch ALL posts on the profile (hard safety cap 50000)
SCRAPE_MAX_POSTS=0
# API Add/Refresh/bulk: 0 = all posts (same as above). Set e.g. 48 only if you need a fast sample.
SCRAPE_INLINE_MAX_POSTS=0
# Cap per-post detail enrich (views via opening pages). Timeline still gets ALL posts.
SCRAPE_INLINE_ENRICH_MAX=24
# Hard wall-clock limit for one API scrape job (frees the queue if IG/proxy hangs)
SCRAPE_JOB_TIMEOUT_SECONDS=480
# Mark scrape_progress.active as interrupted after this many seconds without updates
SCRAPE_STALE_SECONDS=600
# Set to 1 only if you want Playwright to finish incomplete HTTP timelines (can hang)
# SCRAPE_BROWSER_ON_PARTIAL=0
SCRAPE_POSTS_PAGE_SIZE=12
SCRAPE_PAGE_DELAY_SECONDS=0.8
# Retries for Instagram 429 / 5xx during feed pagination (root cause of stuck-at-12)
SCRAPE_HTTP_RETRIES=5
# Consecutive idle scrolls (no posts/height/network/DOM) before declaring end
SCRAPE_SCROLL_IDLE_STREAK=5
# 0 = enrich every post missing likes/comments/views (set a number to cap)
# WARNING: enrich-all on large accounts is slow — add/refresh run scrape in background
SCRAPE_ENRICH_MAX=0
SCRAPE_ENRICH_DELAY_SECONDS=0.9
SCRAPE_SCROLL_DELAY_SECONDS=1.1
# How many HTTP pagination rounds to run until posts_count is reached
SCRAPE_EXPAND_ROUNDS=8
# When 1, never accept partial timelines as success (default on)
SCRAPE_STRICT=1

# --- Decodo residential proxy pool (rotate ports to avoid IG rate limits) ---
# Option A (recommended): host + user + pass + ports
# SCRAPE_PROXY_HOST=gate.decodo.com
# SCRAPE_PROXY_USER=your_user
# SCRAPE_PROXY_PASS=your_pass
# # 7000/10000 = rotating; 10001+ = sticky dashboard ports
# SCRAPE_PROXY_PORTS=7000,10001,10002,10003,10004,10005,10006,10007
# SCRAPE_PROXY_SCHEME=http
# SCRAPE_PROXY_USER_PREFIX=user-
# SCRAPE_PROXY_SESSION_ROTATE=1
# SCRAPE_PROXY_COOLDOWN_SECONDS=60
#
# Option B: comma-separated full URLs
# SCRAPE_PROXY_URLS=http://user:pass@gate.decodo.com:7000,http://user:pass@gate.decodo.com:10001
#
# Option C: single URL (legacy)
# SCRAPE_PROXY_URL=http://user:pass@gate.decodo.com:7000

FOLLOWER_GROWTH_NOTIFY_PCT=5
ENGAGEMENT_SPIKE_NOTIFY_PCT=50

