MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=instascope

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
# Production: set both so the API allows the web UI origin
# CORS_ORIGINS=http://62.238.57.52:3000
# WEB_ORIGIN=http://62.238.57.52:3000
# NEXT_PUBLIC_API_URL=http://62.238.57.52:8000/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

SCRAPE_DELAY_SECONDS=2
SCRAPE_HEADLESS=true
# 0 = fetch ALL posts on the profile (hard safety cap 50000)
SCRAPE_MAX_POSTS=0
# API Add/Refresh/bulk: 0 = all posts (same as above). Set e.g. 48 only if you need a fast sample.
SCRAPE_INLINE_MAX_POSTS=0
# Cap per-post detail enrich (views via opening pages). Timeline still gets ALL posts.
SCRAPE_INLINE_ENRICH_MAX=24
SCRAPE_POSTS_PAGE_SIZE=12
SCRAPE_PAGE_DELAY_SECONDS=0.8
# Retries for Instagram 429 / 5xx during feed pagination (root cause of stuck-at-12)
SCRAPE_HTTP_RETRIES=5
# Consecutive idle scrolls (no posts/height/network/DOM) before declaring end
SCRAPE_SCROLL_IDLE_STREAK=5
# 0 = enrich every post missing likes/comments/views (set a number to cap)
# WARNING: enrich-all on large accounts is slow — add/refresh run scrape in background
SCRAPE_ENRICH_MAX=0
SCRAPE_ENRICH_DELAY_SECONDS=0.9
SCRAPE_SCROLL_DELAY_SECONDS=1.1
# How many HTTP pagination rounds to run until posts_count is reached
SCRAPE_EXPAND_ROUNDS=8
# When 1, never accept partial timelines as success (default on)
SCRAPE_STRICT=1
# SCRAPE_PROXY_URL=http://user:pass@proxy:8080

FOLLOWER_GROWTH_NOTIFY_PCT=5
ENGAGEMENT_SPIKE_NOTIFY_PCT=50

